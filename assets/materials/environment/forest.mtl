# Original physically-based winter forest material set. Values are linear reflectance factors.
newmtl pine_bark
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/bark-albedo.bmp
map_Bump ../../textures/environment/bark-normal.bmp
map_Pr ../../textures/environment/bark-roughness.bmp
map_AO ../../textures/environment/bark-ao.bmp
