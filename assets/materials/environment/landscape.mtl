# Original Sakkola winter landscape materials.
newmtl snow
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/snow-albedo.bmp
map_Bump ../../textures/environment/snow-normal.bmp
map_Pr ../../textures/environment/snow-roughness.bmp
map_AO ../../textures/environment/snow-ao.bmp
newmtl frozen_field
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/packed_snow-albedo.bmp
map_Bump ../../textures/environment/packed_snow-normal.bmp
map_Pr ../../textures/environment/packed_snow-roughness.bmp
map_AO ../../textures/environment/packed_snow-ao.bmp
newmtl packed_track
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/packed_snow-albedo.bmp
map_Bump ../../textures/environment/packed_snow-normal.bmp
map_Pr ../../textures/environment/packed_snow-roughness.bmp
map_AO ../../textures/environment/packed_snow-ao.bmp
newmtl shore_snow
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/snow-albedo.bmp
map_Bump ../../textures/environment/snow-normal.bmp
map_Pr ../../textures/environment/snow-roughness.bmp
map_AO ../../textures/environment/snow-ao.bmp
newmtl frozen_ice
# The blue-grey albedo is complete; frozen water is a dielectric, not a metal.
# Pr=1 leaves the calibrated roughness map as the absolute linear roughness field.
Kd 1.0 1.0 1.0
Pr 1.0
Pm 0.0
map_Kd ../../textures/environment/ice-albedo.bmp
map_Bump ../../textures/environment/ice-normal.bmp
map_Pr ../../textures/environment/ice-roughness.bmp
map_AO ../../textures/environment/ice-ao.bmp
